<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_light">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_background"
        android:paddingStart="24dp"
        android:paddingEnd="16dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/headerDiver"
            android:layout_width="38dp"
            android:layout_height="52dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:src="@drawable/ic_diver_header"
            android:alpha="0.9"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Прыжки в воду"
            android:textColor="@color/brand_white"
            android:textSize="24sp"
            android:fontFamily="@font/stapel_bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/headerTitle"
            android:layout_marginTop="2dp"
            android:text="Калькулятор коэффициента трудности"
            android:textColor="#B3C2E6"
            android:textSize="13sp"
            android:fontFamily="@font/stapel_medium" />

    </RelativeLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:text="Введите номер, положение и высоту"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/stapel_bold"
            android:textSize="20sp"
            android:gravity="center" />

    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Номер прыжка"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="@font/stapel_medium"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxStrokeColor="@color/brand_blue"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/codeInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:hint="например, 403"
                            android:textColor="@color/brand_navy"
                            android:textSize="28sp"
                            android:fontFamily="@font/stapel_bold"
                            android:gravity="center" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Положение"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="@font/stapel_medium"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:layout_marginBottom="10dp" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/positionToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="false">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPosA"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="A"
                            android:textSize="17sp"
                            android:fontFamily="@font/stapel_bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPosB"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="B"
                            android:textSize="17sp"
                            android:fontFamily="@font/stapel_bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPosC"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="C"
                            android:textSize="17sp"
                            android:fontFamily="@font/stapel_bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPosD"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="D"
                            android:textSize="17sp"
                            android:fontFamily="@font/stapel_bold" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Высота, м"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="@font/stapel_medium"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:layout_marginBottom="10dp" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/heightToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="false">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnH1"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="1"
                            android:textSize="14sp"
                            android:fontFamily="@font/stapel_bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnH3"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="3"
                            android:textSize="14sp"
                            android:fontFamily="@font/stapel_bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnH5"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="5"
                            android:textSize="14sp"
                            android:fontFamily="@font/stapel_bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnH75"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="7.5"
                            android:textSize="13sp"
                            android:fontFamily="@font/stapel_bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnH10"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="10"
                            android:textSize="14sp"
                            android:fontFamily="@font/stapel_bold" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
